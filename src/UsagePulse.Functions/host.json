{
  "version": "2.0",
  "telemetryMode": "OpenTelemetry",
  "extensions": {
    "serviceBus": {
      "prefetchCount": 50,
      "messageHandlerOptions": {
        "maxConcurrentCalls": 16,
        "autoCompleteMessages": false
      }
    },
    "eventHubs": {
      "batchCheckpointFrequency": 1,
      "prefetchCount": 200,
      "maxBatchSize": 100
    }
  }
}
